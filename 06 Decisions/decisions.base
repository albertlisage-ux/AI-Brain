filters:
  and:
    - 'type == "decision"'
    - 'file.folder != "08 Templates"'
properties:
  file.name:
    displayName: Decision
  topics:
    displayName: Topics
  status:
    displayName: Status
  project:
    displayName: Project
views:
  - type: table
    name: Decisions
    order: [file.name, topics, status, project]
  - type: list
    name: Active Decisions
    filters:
      and:
        - 'status == "active"'
    order: [file.name, topics]
